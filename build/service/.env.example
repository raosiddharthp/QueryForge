# Copy to .env for local development. In production this is injected via
# Secret Manager at deploy time (see infra/main.tf) — never committed, never
# baked into the container image.

# Gemini Developer API key from https://aistudio.google.com (free tier).
# Deliberately NOT a Vertex AI credential — see ADR-004.
GEMINI_API_KEY=your-ai-studio-key-here

# GCP project for Firestore (Application Default Credentials handle auth
# locally via `gcloud auth application-default login`).
GOOGLE_CLOUD_PROJECT=queryforge-prod
